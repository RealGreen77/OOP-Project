# Copy to .env to override docker-compose defaults. Never commit real secrets.
DB_USERNAME=itsm
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-random-string-of-at-least-32-bytes
SEED_DEMO_DATA=true

# --- Real e-mail (optional). Leave commented to keep using the Mailpit inbox at :8025 ---
